@startuml
title SD04 - Correction, combined and timed replacement (UC04 / UC05; F06-F09)
skinparam defaultFontName Arial
skinparam shadowing false
skinparam sequenceMessageAlign center
hide footbox
participant "voice :\nVoiceInputService" as Voice
participant "controller :\nApplicationController" as Controller
participant "controls :\nControlManager" as Controls
participant "agent :\nVoiceCommandAgent" as Agent
participant "executor :\nActionExecutor" as Executor
participant "oldTimer :\nTimedPressCommand" as OldTimer
participant "up :\nKeyUpCommand" as KeyUp
participant "down :\nKeyDownCommand" as KeyDown
participant "freshTimer :\nTimedPressCommand" as FreshTimer
participant "game :\nGameModel" as Game
participant "view :\nGameView" as View

note over Controller,Game
  Current held set = {RIGHT}; a timer may be active.
  New input enters through GUI voice or either frontend's text input.
  Input handling, accepted completions and timer expiry share one application loop.
  Alternatives below correspond to the example inputs "right no left",
  "up and right", and "a little left", respectively.
end note
Voice -> Controller : handleTranscript(exampleText, utteranceId, epoch)
Controller -> Controller : submit(normalizedText, inputUtterance)
Controller -> Controls : beginInput(++version)
Controller -> Controls : getContext()
Controls --> Controller : current ControlContext
Controller -> Agent : interpret(update, context)
ref over Controller,Agent : SD01 / SD02: async DecisionModel -> local SemIf -> stamped ActionDecision

opt older inference finishes after the new input
  Agent --> Controller : older decision completion
  Controller -> Controller : handleDecision(olderDecision)
  Controller -> Controls : accept(olderDecision)
  Controls --> Controller : false (old transcript version); unchanged
end

Agent --> Controller : latest decision completion
Controller -> Controller : handleDecision(decision)
Controller -> Controls : accept(decision)
alt request became stale while interpreting
  Controls --> Controller : false; no commands
else current request
  Controls -> Controls : validate(decision)
  alt same semantic decision in the same utterance
    Controls --> Controller : true; existing timer is not restarted
  else KEEP_CURRENT or NO_ACTION
    note right of Controls
      Accept metadata; increment revision.
      Preserve held directions, timer and lastMovement.
    end note
    Controls --> Controller : true
  else new valid directional decision
    Controls -> Controls : plan(decision)
    note right of Controls
      Compute complete desired direction set from the
      pre-cancel held snapshot. Opposed pairs are invalid.
      Plan KeyUp for unwanted directions and KeyDown for
      every desired direction, or one new TimedPressCommand.
    end note
    Controls -> Executor : cancelAll()
    opt a previous timed press is still active
      Executor -> OldTimer : cancel(game)
      OldTimer -> Game : release(RIGHT)
    end
    alt correction: SWITCH {LEFT}
      Controls -> Executor : execute([KeyUpCommand(RIGHT), KeyDownCommand(LEFT)])
      Executor -> KeyUp : execute(game)
      KeyUp -> Game : release(RIGHT)
      Executor -> KeyDown : execute(game)
      KeyDown -> Game : press(LEFT)
    else combined: PRESS {UP, RIGHT}
      Controls -> Executor : execute([KeyDownCommand(UP), KeyDownCommand(RIGHT)])
      loop fresh KeyDownCommand for each desired direction
        Executor -> KeyDown : execute(game)
        KeyDown -> Game : press(direction)
      end
    else small movement: TIMED_PRESS {LEFT}, 200 ms
      Controls -> Executor : execute([KeyUpCommand(RIGHT), freshTimer])
      Executor -> KeyUp : execute(game)
      KeyUp -> Game : release(RIGHT)
      Executor -> FreshTimer : execute(game)
      FreshTimer -> Game : press(LEFT)
    end
    note right of Controls
      Store MovementIntent(type, directions, durationMs).
      Record accepted request; increment revision.
    end note
    Controls --> Controller : true
  end
  Controller -> View : showMessage(accepted action / no-action status)
  Controller -> Controller : publish()
  Controller -> Game : getSnapshot()
  Game --> Controller : snapshot
  Controller -> View : render(snapshot)
end

== Later application tick ==
Controller -> Controller : advance(dt)
Controller -> Controls : advance(dt)
Controls -> Executor : advance(dt)
opt a timed command reaches its deadline
  Executor -> FreshTimer : advance(dt, game)
  FreshTimer -> FreshTimer : cancel(game)
  FreshTimer -> Game : release(LEFT)
  FreshTimer --> Executor : true
  Executor --> Controls : true (expired)
  note right of Controls : Increment revision; keep lastMovement.
end
Controller -> Game : update(dt)
ref over Game,View : GameObserver updates the selected frontend

note over Controller,Agent
  Invalid current schemas or current inference failures invoke failCurrent():
  invalidateControls() releases inputs, clears history and stops voice capture.
  Stale failures are ignored. There is no independent timer callback or AI game mutation.
end note
@enduml
