@startuml
title SD05 - Fall and Start Recovery (Stage 2; UC06; F01, F09, F10)
hide footbox
skinparam defaultFontName Arial
skinparam maxMessageSize 65
control "controller : ApplicationController" as controller
control "controls : ControlManager" as controls
participant "executor : ActionExecutor" as executor
participant "release : ReleaseAllCommand" as release
participant "agent : VoiceCommandAgent" as agent
participant "voice : VoiceInputService" as voice
entity "game : GameModel" as game
entity "player : Player" as player
participant "state : PlayerState" as state
entity "level : Level" as level
boundary "view : GameView" as view

note over controller, view
  All game/control mutations run on the controller loop.
  Selected view is JavaFxGameView or CliView; only GUI has voice input.
  state denotes the player's current State object at each tick.
end note

controller -> controller : advance(seconds)
controller -> controls : advance(seconds)
controls -> executor : advance(seconds)
controller -> game : update(seconds)
game -> player : update(game, seconds)
player -> state : update(player, game, seconds)
note right of state : ActiveState: check position throughout movement substeps.
state -> player : move(step, held)
state -> game : evaluatePosition()
game -> level : isSafe(position)
level --> game : false
game -> player : setState(new FallingState())
game -> game : notifyObservers(FALL_DETECTED event)
game -> controller : onGameEvent(event)
controller -> controller : invalidateControls()
controller -> controls : reset()
note right of controls
  Increment epoch and revision before cancellation.
  Clear latestVersion, previousCommand, lastAccepted,
  lastMovement and lastRepeatedUtterance.
end note
controls -> executor : cancelAll()
note right of executor : Cancel any owned TimedPressCommand and release its inputs.
controls -> executor : execute([new ReleaseAllCommand()])
executor -> release : execute(game)
release -> game : releaseAll()
controller -> agent : reset()
note right of agent : Cancel pending results and clear frozen utterance context.
opt GUI voice service attached
  controller -> voice : stop()
end
game -> view : onGameEvent(FALL_DETECTED event)
view -> view : render(event.snapshot)
view -> view : showMessage("You fell. Returning to the start.")
game -> game : notifyObservers(STATE_CHANGED event)
game -> controller : onGameEvent(event)
game -> view : onGameEvent(event)
opt GUI, or live CLI display interval elapsed
  view -> view : render(event.snapshot)
end

== Next tick: return to start ==
controller -> controller : advance(seconds)
controller -> controls : advance(seconds)
controller -> game : update(seconds)
game -> player : update(game, seconds)
player -> state : update(player, game, seconds)
note right of state : FallingState
state -> game : resetToStart()
game -> game : releaseAll()
game -> player : setState(new RespawningState())
game -> level : start()
level --> game : start position
game -> player : respawn(start position)
game -> game : notifyObservers(STATE_CHANGED event)
game -> controller : onGameEvent(event)
game -> view : onGameEvent(event)
opt GUI, or live CLI display interval elapsed
  view -> view : render(event.snapshot)
end

== Next tick: accept fresh instructions ==
controller -> controller : advance(seconds)
controller -> controls : advance(seconds)
controller -> game : update(seconds)
game -> player : update(game, seconds)
player -> state : update(player, game, seconds)
note right of state : RespawningState
state -> player : setState(new ActiveState())
state -> game : getSnapshot()
game --> state : active snapshot at start, no held inputs
state -> game : notifyObservers(RESPAWNED event)
game -> controller : onGameEvent(event)
opt GUI voice was requested before the fall
  controller -> controls : getContext()
  controls --> controller : fresh epoch, lastMovement = null
  controller -> voice : start(fresh epoch)
end
game -> view : onGameEvent(RESPAWNED event)
view -> view : render(event.snapshot)
view -> view : showMessage("Back at the start. Give a fresh instruction.")
note over controller, view
  GameModel also publishes STATE_CHANGED after this update.
  CLI lifecycle events always refresh; ordinary STATE_CHANGED frames are throttled.
  Plain CLI suppresses periodic frames. SD02 shows fixed-panel redraw and input handling.
  Old decisions cannot match the new epoch. "Again" has no movement to repeat.
  Every fall returns to Level.start(); no checkpoints or AI navigation.
end note
@enduml
