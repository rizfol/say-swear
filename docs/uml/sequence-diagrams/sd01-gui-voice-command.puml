@startuml
title SD01 - GUI voice command (UC01; F02-F04, F09)
hide footbox
skinparam defaultFontName Arial
skinparam maxMessageSize 48
actor Player as human
boundary "gui : JavaFxGameView" as gui
control "controller : ApplicationController" as controller
participant "voice : VoiceInputService" as voice
participant "mic : MicrophoneDevice" as mic
participant "recognizer : SherpaOnnxAdapter" as recognizer
participant "agent : VoiceCommandAgent" as agent
participant "model : OpenJevAdapter" as model
participant "Local SemIf / Qwen3.5 4B" as service <<external HTTP>>
control "controls : ControlManager" as controls
entity "game : GameModel" as game

note over gui, controller
  Preconditions: GUI is composed; controller.start() registered
  the controller and selected view as game observers.
end note
human -> gui : requestStartVoice()
gui ->> controller : startVoiceControl()
controller -> controls : getContext()
controls --> controller : context with current epoch
controller -> voice : start(context.epoch)
voice -> recognizer : start(partial callback, endpoint callback, error callback)
note over voice, recognizer : Native initialization and capture run on the voice worker.
voice -> mic : open()
voice ->> controller : handleVoiceReady(epoch)
controller -> gui : showVoiceStatus("Listening - speak a movement instruction")

loop active voice session; example changed partial is "right"
  voice -> mic : readSamples()
  mic --> voice : float[] samples
  voice -> recognizer : acceptAudio(samples)
  recognizer -> voice : partial(session, "right")
  voice ->> controller : handleTranscript("right", utteranceId, epoch)
  note right of controller
    Ignore old epochs, superseded utterances and duplicate text.
    The accepted callback posts work to the application loop.
  end note
  controller -> controller : submit("right", voiceUtterance)
  controller -> gui : showTranscript("right")
  controller -> controls : beginInput(++version)
  controller -> controls : getContext()
  controls --> controller : context
  controller ->> agent : interpret(update, context)
  note over agent, model
    Freeze context for this utterance, including lastMovement.
    Two active calls and one latest pending input; deadline includes waiting.
  end note
  agent ->> model : decide(update, baseContext)
  model ->> service : POST /decide\n{model, state, question, choices, timeoutMs}
  note right of service
    Genuine SemIf logits: 1-4 bounded readouts.
    Select one of 52 semantic actions.
    No map, position, goal or game access.
  end note
  service --> model : {backend: "semif", model, choice: "PRESS_RIGHT"}
  model --> agent : validated candidate ActionDecision
  agent -->> controller : completion with locally stamped request metadata
  controller -> controller : handleDecision(decision)
  controller -> controls : accept(decision)
  ref over controls, game
    SD02: validate freshness/schema, plan and execute Java commands.
    Current valid PRESS_RIGHT calls GameModel.press(RIGHT).
  end ref
  controls --> controller : accepted
  controller -> gui : showMessage("Accepted: PRESS [RIGHT]")
  controller -> controller : publish()
  controller -> game : getSnapshot()
  game --> controller : snapshot
  controller -> gui : render(snapshot)
  opt recognizer reports an utterance endpoint
    recognizer -> voice : endpoint(session)
    note right of voice : Increment the captured session's utterance counter.
  end
end

note over gui, game
  The loop above shows a current, active, successful request.
  Stale decisions do not mutate controls; invalid current decisions fail closed.
  GUI render coalesces updates onto the JavaFX thread; ticks continue independently.
end note
opt current provider failure, deadline, or voice failure
  ref over controller, controls
    Provider completion checks isCurrent(update) before failCurrent(message).
    Capture failures call handleVoiceFailure(message, originatingEpoch).
    failCurrent -> invalidateControls(): controls.reset(), agent.reset(), voice.stop().
    Voice must be explicitly restarted after a failure; SD05 shows reset mechanics.
  end ref
end
@enduml
