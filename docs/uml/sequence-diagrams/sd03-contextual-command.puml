@startuml
title SD03 - Contextual command: repeat after expiry (UC03; F05, F08, F09)
skinparam defaultFontName Arial
skinparam shadowing false
skinparam sequenceMessageAlign center
hide footbox
actor Player
participant "controller :\nApplicationController" as Controller
participant "controls :\nControlManager" as Controls
participant "executor :\nActionExecutor" as Executor
participant "oldTimer :\nTimedPressCommand" as OldTimer
participant "game :\nGameModel" as Game
participant "agent :\nVoiceCommandAgent" as Agent
participant "model :\nOpenJevAdapter" as Model
participant "SemIfService\n(local Qwen3.5 4B)" as Service <<external HTTP>>
participant "proposal :\nActionDecision" as Proposal
participant "freshTimer :\nTimedPressCommand" as FreshTimer
participant "view :\nGameView" as View

note over Controls,OldTimer
  Previously accepted: TIMED_PRESS {RIGHT}, 200 ms.
  lastMovement = MovementIntent(TIMED_PRESS, {RIGHT}, 200).
  The stored value is immutable semantics, not oldTimer.
end note
== Automatic expiry on the application loop ==
Controller -> Controller : advance(dt)
Controller -> Controls : advance(dt)
Controls -> Executor : advance(dt)
Executor -> OldTimer : advance(dt, game)
OldTimer -> OldTimer : cancel(game)
OldTimer -> Game : release(RIGHT)
OldTimer --> Executor : true (expired)
Executor --> Controls : true
note right of Controls
  Increment revision; preserve lastMovement.
  heldDirections is now empty.
end note
Controller -> Game : update(dt)
ref over Game,View : Observer state update (SD02 / SD05)

== New utterance: again ==
Player -> Controller : submitTextCommand("again")
note left of Controller
  CLI / GUI text entry shown.
  Voice enters through handleTranscript
  and reaches the same submit operation.
end note
Controller -> Controller : submit("again", newUtterance)
Controller -> Controls : beginInput(++version)
Controller -> Controls : getContext()
Controls -> Game : getSnapshot()
Game --> Controls : held={}, ACTIVE
Controls --> Controller : ControlContext(..., lastMovement)
Controller -> Agent : interpret(update, context)
note right of Agent
  Freeze base context for this utterance.
  Retain current dispatch context for stamping.
end note
Agent -> Model : decide(update, baseContext)
Model -> Service : POST /decide\ntranscript + bounded control context
Service --> Model : {backend: "semif", model, choice: "REPEAT_LAST"}
note right of Model : Map choice to REPEAT_LAST, directions={}, durationMs=0.
Model --> Agent : proposal (async completion)
Agent -> Proposal : withRequest(update, dispatchContext)
Proposal --> Agent : decision with current epoch/version/revision
Agent --> Controller : decision (completion enqueued on application loop)
Controller -> Controller : handleDecision(decision)
Controller -> Controls : accept(decision)
alt stale epoch / version / revision, or player not ACTIVE
  Controls --> Controller : false; no mutation
else current request
  Controls -> Controls : validate(decision)
  alt already repeated in this utterance
    Controls --> Controller : true; do not restart timer
  else lastMovement is absent
    note right of Controls
      Record accepted request and increment revision.
      No commands; no movement history is invented.
    end note
    Controls --> Controller : true
    Controller -> View : showMessage("No previous movement to repeat...")
  else remembered movement exists
    Controls -> Controls : plan(decision)
    note right of Controls
      Resolve TIMED_PRESS {RIGHT}, 200 ms using
      current request metadata; construct fresh commands.
      Snapshot desired held inputs before cancellation.
    end note
    Controls -> Executor : cancelAll()
    Controls -> Executor : execute([freshTimer])
    Executor -> FreshTimer : execute(game)
    FreshTimer -> Game : press(RIGHT)
    note right of Controls
      Record lastRepeatedUtterance; increment revision.
      Preserve the resolved lastMovement value.
    end note
    Controls --> Controller : true
    Controller -> View : showMessage("Accepted: REPEAT_LAST TIMED_PRESS [RIGHT] for 200 ms")
  end
  Controller -> Controller : publish()
  Controller -> Game : getSnapshot()
  Game --> Controller : snapshot
  Controller -> View : render(snapshot)
end

note over Controls,Agent
  "other way" remains an AI interpretation of the initial held set:
  held RIGHT -> SWITCH LEFT -> KeyUpCommand(RIGHT), KeyDownCommand(LEFT).
  "again" repeats the stored resolved movement, not the previous raw sentence.
  Automatic expiry and spoken "stop" preserve history.
  Session pause, failure, fall, restart and close clear it through reset().
end note
@enduml
