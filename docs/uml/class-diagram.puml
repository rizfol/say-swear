@startuml
title Say Swear - current Java core (Stage 2)
top to bottom direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam nodesep 35
skinparam ranksep 55
skinparam linetype polyline
hide empty members

package "Presentation / MVC" as UI #EAF3FA {
  interface GameView {
    +render(snapshot: GameSnapshot)
    +showMessage(message: String)
    +showTranscript(text: String)
    +showVoiceStatus(status: String)
    +onGameEvent(event: GameEvent)
  }
  class JavaFxGameView {
    +root(): Parent
    +bindController(controller)
    +requestStartVoice()
    +requestStopVoice()
    +render(snapshot: GameSnapshot)
  }
  class CliView {
    -terminal: Terminal [0..1]
    -status: Status [0..1]
    -lineReader: DashboardReader [0..1]
    -latestSnapshot: GameSnapshot
    {static} +open(quietCli: boolean): CliView
    +setSessionDescription(value: String)
    +showHelp()
    +readCommand(): String
    +setInteractive(interactive: boolean)
    +render(snapshot: GameSnapshot)
    +onGameEvent(event: GameEvent)
    +close()
    -refreshDashboard()
    -updateDashboard()
  }
  class Main {
    {static} +main(arguments: String[])
    {static} -runCli(configuration)
  }
  GameView <|.. JavaFxGameView
  GameView <|.. CliView
  Main --> CliView
}

package "Application / MVC controller" as APP #EAF3FA {
  class ApplicationController {
    -voiceRequested: boolean
    -version, utterance: long
    +start()
    +submitTextCommand(text: String)
    +handleTranscript(text, sourceUtterance, epoch)
    +handleDecision(decision: ActionDecision)
    +startVoiceControl()
    +stopVoiceControl()
    +handleVoiceReady(epoch)
    +handleVoiceFailure(message, epoch)
    +pauseControls()
    +restart()
    +onGameEvent(event: GameEvent)
    +getSnapshot(): GameSnapshot
    +close()
    -submit(text, inputUtterance)
    -advance(seconds: double)
    -isCurrent(update: TranscriptUpdate): boolean
    -failCurrent(message: String)
    -invalidateControls()
    -publish()
  }
}

package "Language interpretation / Adapter" as AI #EEEAF8 {
  class VoiceCommandAgent {
    -baseContext: ControlContext
    +interpret(update, context): CompletionStage
    +reset()
    +close()
  }
  interface DecisionModel {
    +decide(update, baseContext): CompletionStage
    +close()
  }
  class OpenJevAdapter {
    +decide(update, baseContext): CompletionStage
    +close()
  }
  class DemoDecisionModel {
    +decide(update, baseContext): CompletionStage
  }
  class "Local SemIf / Qwen3.5 4B" as SemIfService <<external HTTP>> {
    POST /decide
    GET /health
  }
  VoiceCommandAgent --> DecisionModel
  DecisionModel <|.. OpenJevAdapter
  DecisionModel <|.. DemoDecisionModel
  OpenJevAdapter ..> SemIfService : loopback HTTP
}

package "Voice input / Adapter" as VOICE #EEEAF8 {
  class VoiceInputService {
    +start(epoch: long)
    +acceptAudio(samples: float[])
    +onPartial(text: String)
    +onEndpoint()
    -partial(session, text: String)
    -endpoint(session)
    +stop()
    +close()
  }
  interface StreamingSpeechRecognizer {
    +start(onPartial, onEndpoint, onError)
    +acceptAudio(samples: float[])
    +stop()
    +close()
  }
  class SherpaOnnxAdapter {
    +start(onPartial, onEndpoint, onError)
    +acceptAudio(samples: float[])
    +stop()
  }
  class MicrophoneDevice {
    +open()
    +readSamples(): float[]
    +close()
  }
  VoiceInputService --> StreamingSpeechRecognizer
  StreamingSpeechRecognizer <|.. SherpaOnnxAdapter
  VoiceInputService --> MicrophoneDevice
}

package "Deterministic controls / Command" as CONTROL #E9F4EB {
  class ControlManager {
    -previousCommand: String
    -lastAccepted: ActionDecision
    -lastMovement: MovementIntent [0..1]
    -lastRepeatedUtterance: long
    -epoch, revision, latestVersion: long
    +beginInput(version: long)
    +getContext(): ControlContext
    +accept(decision: ActionDecision): boolean
    +validate(decision: ActionDecision): boolean
    +plan(decision: ActionDecision): List<GameCommand>
    +advance(deltaTime: double)
    +reset()
  }
  class ActionExecutor {
    -activeTimed: List<TimedPressCommand>
    +execute(commands: List<GameCommand>)
    +cancelAll()
    +advance(deltaTime: double): boolean
  }
  interface GameCommand {
    +execute(game: GameModel)
    +cancel(game: GameModel)
  }
  class KeyDownCommand {
    -direction: Direction
  }
  class KeyUpCommand {
    -direction: Direction
  }
  class ReleaseAllCommand
  class TimedPressCommand {
    -directions: Set<Direction>
    -durationMs: int
    -remainingMs: double
    +advance(deltaTime, game): boolean
  }
  ControlManager --> ActionExecutor
  ActionExecutor o--> GameCommand
  GameCommand <|.. KeyDownCommand
  GameCommand <|.. KeyUpCommand
  GameCommand <|.. ReleaseAllCommand
  GameCommand <|.. TimedPressCommand
}

package "Immutable interpretation values" as VALUES #F8F4E8 {
  class TranscriptUpdate <<record>> {
    text: String
    utteranceId, version, epoch: long
  }
  class ControlContext <<record>> {
    heldDirections: Set<Direction>
    previousCommand: String
    epoch, revision, latestVersion: long
    movementAllowed: boolean
    lastMovement: MovementIntent [0..1]
  }
  class ActionDecision <<record>> {
    type: ActionType
    directions: Set<Direction>
    durationMs: int
    transcriptVersion, utteranceId: long
    epoch, contextRevision: long
    sourceText: String
    +withRequest(update, context): ActionDecision
  }
  class MovementIntent <<record>> {
    type: ActionType
    directions: Set<Direction>
    durationMs: int
  }
  enum ActionType {
    PRESS
    RELEASE
    SWITCH
    TIMED_PRESS
    KEEP_CURRENT
    RELEASE_ALL
    NO_ACTION
    REPEAT_LAST
  }
  ControlContext --> "0..1" MovementIntent
  ActionDecision --> ActionType
  MovementIntent --> ActionType
  TranscriptUpdate -[hidden]right- ControlContext
}

package "Game model / Observer" as GAME #E9F4EB {
  class GameModel {
    -heldDirections: Set<Direction>
    -observers: List<GameObserver>
    +update(deltaTime: double)
    +evaluatePosition()
    +press(direction: Direction)
    +release(direction: Direction)
    +releaseAll()
    +resetToStart()
    +restart()
    +getSnapshot(): GameSnapshot
    +addObserver(observer: GameObserver)
    +notifyObservers(event: GameEvent)
  }
  class Player {
    -position, velocity: Vector2
    -state: PlayerState
    +update(game, deltaTime)
    +move(deltaTime, held)
    +setState(state: PlayerState)
    +respawn(position: Vector2)
  }
  class Level {
    -safePath: List<Vector2>
    -pathHalfWidth: double
    -goal: Vector2
    +start(): Vector2
    +isSafe(position: Vector2): boolean
    +isGoal(position: Vector2): boolean
  }
  interface GameObserver {
    +onGameEvent(event: GameEvent)
  }
  class GameEvent <<record>> {
    type: GameEventType
    snapshot: GameSnapshot
  }
  class GameSnapshot <<record>> {
    position, velocity: Vector2
    heldDirections: Set<Direction>
    status: PlayerStatus
    level: Level
  }
  class Vector2 <<record>> {
    x: double
    y: double
  }
  enum Direction {
    UP
    DOWN
    LEFT
    RIGHT
  }
  enum GameEventType {
    STATE_CHANGED
    FALL_DETECTED
    RESPAWNED
    GOAL_REACHED
  }
  GameModel *--> Player
  GameModel *--> Level
  GameModel o--> GameObserver
  GameModel ..> GameEvent
  GameEvent --> GameSnapshot
  GameEvent --> GameEventType
  Level -[hidden]right- Vector2
  Vector2 -[hidden]right- Direction
}

package "Player lifecycle / State" as STATES #E9F4EB {
  interface PlayerState {
    +update(player, game, deltaTime)
    +allowsMovement(): boolean
    +status(): PlayerStatus
  }
  class ActiveState
  class FallingState
  class RespawningState
  class FinishedState
  enum PlayerStatus {
    ACTIVE
    FALLING
    RESPAWNING
    FINISHED
  }
  PlayerState <|.. ActiveState
  PlayerState <|.. FallingState
  PlayerState <|.. RespawningState
  PlayerState <|.. FinishedState
  PlayerState --> PlayerStatus
}

Main --> ApplicationController
ApplicationController --> GameView : selected view
GameView -[norank]-|> GameObserver
ApplicationController .[norank].|> GameObserver
ApplicationController --> VoiceInputService : optional GUI input
ApplicationController --> VoiceCommandAgent
ApplicationController --> ControlManager
ApplicationController --> GameModel
ControlManager --> GameModel
ActionExecutor --> GameModel : command receiver
Player *--> PlayerState
' Value references are shown by typed attributes and method results above.
' Hidden links affect layout only, keeping packages in vertical tiers.
Main -[hidden]down-> ApplicationController
ApplicationController -[hidden]down-> ControlManager
ControlManager -[hidden]down-> GameModel
ControlManager -[hidden]right-> VoiceCommandAgent
VoiceInputService -[hidden]down-> VoiceCommandAgent
GameModel -[hidden]right-> ControlContext

note bottom of MovementIntent
  Resolved PRESS / SWITCH / TIMED_PRESS only.
  No old request identity or running command.
  Timer expiry and spoken stop preserve it;
  session reset, fall and restart clear it.
end note

legend bottom left
  Key methods shown; parameter/return types shortened where evident.
  interpret/decide return CompletionStage<ActionDecision>.
  Private controller operations run on one serialized loop.
  Views share the same game, controls and agent.
  CliView uses JLine Terminal/Status and its private DashboardReader.
  Live CLI redraws a fixed panel; plain sessions omit periodic maps.
  CliView implements Java AutoCloseable; controller closes first.
  AI sees control context only: no map, position or goal.
  Local SemIf is an external HTTP boundary, not a Java class.
endlegend
@enduml
