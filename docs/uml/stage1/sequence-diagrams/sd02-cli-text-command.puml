@startuml
title SD02 - CLI Text Command (UC02; F01, F04, F09)
hide footbox
skinparam maxMessageSize 70
actor "Player" as human
boundary "cli : CliView" as cli
control "controller : ApplicationController" as controller
participant "agent : VoiceCommandAgent" as agent
participant "model : OpenJevAdapter" as model
participant "service : OpenJevService" as service
control "controls : ControlManager" as controls
participant "executor : ActionExecutor" as executor
participant "command : GameCommand" as command
entity "game : GameModel" as game

human -> controller : start()
controller -> game : addObserver(controller)
controller -> game : addObserver(cli)
controller -> game : getSnapshot()
game --> controller : snapshot
controller -> cli : render(snapshot)
note over cli, controller
  A terminal worker blocks in readCommand(), independently of the fixed loop.
  Each completed line posts submitTextCommand(text) to that loop.
  Each line has a new utteranceId and the same version/epoch checks as voice.
end note

cli -> cli : readCommand()
human -> cli : enter "up" and press Enter
cli --> cli : "up" (completed input line)
cli ->> controller : submitTextCommand("up")
controller -> controls : getContext()
controls --> controller : current context
controller -> controller : handleTranscript("up", newUtteranceId, context.epoch)
controller -> controls : beginInput(update.version)
controller -> controls : getContext()
controls --> controller : dispatch context
controller ->> agent : interpret(update, context)
agent ->> model : decide(update, baseContext)
model ->> service : systemOne(state, choices)
service --> model : bounded choice (e.g. "PRESS_UP")
model --> agent : candidate ActionDecision (e.g. PRESS, {UP})
agent -->> controller : completed ActionDecision with local metadata
controller -> controller : handleDecision(decision)
controller -> controls : accept(decision)
controls -> controls : validate(decision)

alt current, valid movement decision
  controls -> controls : plan(decision)
  controls --> controls : commands (e.g. KeyDownCommand(UP))
  controls -> executor : cancelAll()
  controls -> executor : execute(commands)
  executor -> command : execute(game)
  command -> game : press(UP)
  controls --> controller : true
  controller -> cli : showMessage("Accepted: PRESS UP")
else current NO_ACTION (unrecognized or insufficient instruction)
  controls --> controller : true (no movement change)
  controller -> cli : showMessage("No movement change; try a direction.")
else stale epoch, version, or context revision
  controls --> controller : false (ignore)
  opt still latest version/epoch; only context revision changed
    controller -> controls : getContext()
    controls --> controller : current context confirms revision mismatch
    controller -> cli : showMessage("Control state changed; repeat command.")
  end
end

loop fixed simulation ticks, including while readCommand() waits
  controller -> controller : tick(deltaTime)
  controller -> controls : advance(deltaTime)
  controls -> executor : advance(deltaTime)
  executor --> controls : whether a timed command expired
  note right of controls : Increment revision if a timed action expired.
  controller -> game : update(deltaTime)
  ref over game
    SD05: Player.update delegates to PlayerState;
    ActiveState moves the player and checks path/checkpoint/goal.
  end ref
  game -> game : getSnapshot()
  game --> game : current snapshot
  game -> game : notifyObservers(GameEvent(STATE_CHANGED, snapshot))
  game -> controller : onGameEvent(event)
  game -> cli : onGameEvent(event)
  cli -> cli : render(event.snapshot)
  cli --> human : ASCII path/player/checkpoint/goal and coordinates
  note right of cli
    Display velocity, held directions, and lifecycle status too.
    Coalesce ordinary tick output for readability; show fall,
    checkpoint, and completion events immediately.
  end note
end

ref over cli, game
  SD03: contextual phrases; SD04: corrections, combined and timed actions.
  SD05: fall recovery, checkpoint activation, and goal completion.
  Provider failure uses SD01 handleInputFailure and releases controls;
  the next explicit CLI line can retry. The CLI requires no microphone or ASR.
end ref
@enduml
