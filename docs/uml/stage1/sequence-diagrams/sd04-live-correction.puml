@startuml
title SD04 - Live Correction / Combined / Timed Command (UC04, UC05; F06-F09)
hide footbox
skinparam maxMessageSize 70
actor "Player" as human
boundary "cli : CliView" as cli
control "controller : ApplicationController" as controller
participant "agent : VoiceCommandAgent" as agent
participant "model : OpenJevAdapter" as model
participant "service : OpenJevService" as service
control "controls : ControlManager" as controls
participant "executor : ActionExecutor" as executor
participant "oldTimed : TimedPressCommand" as oldTimed
participant "rightUp : KeyUpCommand" as rightUp
participant "down : KeyDownCommand" as down
participant "newTimed : TimedPressCommand" as newTimed
entity "game : GameModel" as game

note over controller, game
  Precondition: held {RIGHT}; an older request v41 may still be in flight.
  New input v42 supersedes v41 immediately. Existing motion continues until
  a valid replacement is accepted, its timer expires, or cleanup releases it.
  GUI partial transcripts use this same flow (SD01).
end note
cli -> cli : readCommand()
alt correction
  human -> cli : enter "right - no, left"
  cli --> cli : "right - no, left"
  cli ->> controller : submitTextCommand("right - no, left")
else combined instruction
  human -> cli : enter "up and right"
  cli --> cli : "up and right"
  cli ->> controller : submitTextCommand("up and right")
else timed instruction
  human -> cli : enter "a little left"
  cli --> cli : "a little left"
  cli ->> controller : submitTextCommand("a little left")
end
controller -> controls : getContext()
controls --> controller : context (current epoch)
controller -> controller : handleTranscript(text, newUtteranceId, context.epoch)
controller -> controls : beginInput(42)
controller -> controls : getContext()
controls --> controller : dispatch context (held RIGHT, revision r)
controller ->> agent : interpret(updateV42, context)
agent ->> model : decide(updateV42, baseContext)
model ->> service : systemOne(state, choices)
service --> model : SWITCH_LEFT / PRESS_UP_RIGHT / TIMED_LEFT_200
model --> agent : corresponding bounded ActionDecision
agent -->> controller : decisionV42 stamped with dispatch epoch/revision r
controller -> controller : handleDecision(decisionV42)
controller -> controls : accept(decisionV42)
controls -> controls : validate(decisionV42)

alt current valid decision repeats the same accepted semantic result in this utterance
  controls --> controller : true (already accepted; preserve controls and timer)
else current metadata, active player, and valid schema
  note right of controls
    No opposed pair; at most two perpendicular directions.
    Duration is bounded to 100/200/400 ms; "a little" = 200 ms.
    Invalid current payload follows handleInputFailure (SD01).
  end note
  controls -> controls : plan(decisionV42)
  controls --> controls : commands computed from the pre-cancellation held set
  controls -> executor : cancelAll()
  opt a previous timed action is active
    executor -> oldTimed : cancel(game)
    oldTimed -> game : release(RIGHT)
  end
  controls -> executor : execute(commands)
  alt correction: desired set {LEFT}
    executor -> rightUp : execute(game)
    rightUp -> game : release(RIGHT)
    executor -> down : execute(game)
    down -> game : press(LEFT)
  else combined: desired set {UP, RIGHT}
    loop one KeyDownCommand per desired direction
      executor -> down : execute(game)
      down -> game : press(direction)
    end
    note over executor, game
      KeyDown is idempotent. Reasserting both desired directions
      restores RIGHT if cancelAll released an older timed RIGHT.
      Diagonal movement is normalized to the same total speed.
    end note
  else timed: desired set {LEFT}, duration 200 ms
    executor -> rightUp : execute(game)
    rightUp -> game : release(RIGHT)
    executor -> newTimed : execute(game)
    newTimed -> game : press(LEFT)
    note right of newTimed : remainingMs = 200; tracked by ActionExecutor.
  end
  note right of controls : Record accepted decision and increment revision.
  controls --> controller : true
  controller -> cli : showMessage("Accepted action: " + decisionV42.type)
else obsolete metadata or movement no longer allowed
  controls --> controller : false (ignore)
  opt still latest version/epoch and active; only context revision changed
    controller -> controls : getContext()
    controls --> controller : current context confirms revision mismatch
    controller -> cli : showMessage("Control state changed; repeat command.")
  end
else current payload fails defensive schema validation
  controls --> controller : throw IllegalArgumentException (invalid schema)
  controller -> controller : handleInputFailure("invalid decision", epoch, 42)
  ref over controller, game
    SD01 failure handling invokes SD05 cleanup; notify the selected view.
  end ref
end

opt late completion of superseded v41
  agent -->> controller : decisionV41
  controller -> controller : handleDecision(decisionV41)
  controller -> controls : accept(decisionV41)
  controls -> controls : validate(decisionV41)
  controls --> controller : false (41 is not latestVersion 42)
end

opt accepted timed action remains active
  loop fixed ticks while newTimed is active; stop after expiry or cancellation
    controller -> controller : tick(deltaTime)
    controller -> controls : advance(deltaTime)
    controls -> executor : advance(deltaTime)
    executor -> newTimed : advance(deltaTime, game)
    alt remainingMs reaches zero
      newTimed -> newTimed : cancel(game)
      newTimed -> game : release(LEFT)
      newTimed --> executor : true (expired)
      note right of executor : Remove the completed timer from activeTimed.
      executor --> controls : true
      note right of controls : Increment context revision.
    else time remains
      newTimed --> executor : false
      executor --> controls : false
    end
    controller -> game : update(deltaTime)
    ref over game, cli
      STATE_CHANGED publishes current position/held inputs (SD02).
    end ref
  end
end

note over controller, game
  Planning, cancellation, and replacement execute atomically on the application loop.
  No timer callback runs independently. KEEP_CURRENT, NO_ACTION, and an identical
  semantic result in the same utterance preserve the current timer rather than restart it.
  A completion dispatched before a timer expiry fails the changed-revision check.
end note
@enduml
