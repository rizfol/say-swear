@startuml
title Say Swear - shared Java design (Stage 1)
left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "Presentation (MVC views)" {
  interface GameView {
    +render(snapshot: GameSnapshot): void
    +showMessage(message: String): void
  }
  class JavaFxGameView {
    +requestStartVoice(): void
    +requestStopVoice(): void
    +render(snapshot: GameSnapshot): void
    +showTranscript(text: String): void
    +showMessage(message: String): void
    +onGameEvent(event: GameEvent): void
  }
  class CliView {
    +readCommand(): String
    +render(snapshot: GameSnapshot): void
    +showMessage(message: String): void
    +onGameEvent(event: GameEvent): void
  }
}

package "Application" {
  class ApplicationController {
    -nextVersion: long
    -voiceSessionRequested: boolean
    +start(): void
    +startVoiceControl(): void
    +stopVoiceControl(): void
    +submitTextCommand(text: String): void
    +handleTranscript(text: String, utteranceId: long, epoch: long): void
    +handleDecision(decision: ActionDecision): void
    +handleInputFailure(message: String, epoch: long, version: long): void
    +handleVoiceFailure(message: String, epoch: long): void
    +invalidateControls(reason: String): void
    +tick(deltaTime: double): void
    +onGameEvent(event: GameEvent): void
  }
}

package "Game domain" {
  class GameModel {
    -player: Player
    -level: Level
    -checkpoint: Vector2
    -heldDirections: Set<Direction>
    -observers: List<GameObserver>
    +update(deltaTime: double): void
    +evaluatePosition(): void
    +press(direction: Direction): void
    +release(direction: Direction): void
    +releaseAll(): void
    +resetToCheckpoint(): void
    +getSnapshot(): GameSnapshot
    +addObserver(observer: GameObserver): void
    +notifyObservers(event: GameEvent): void
  }
  class Player {
    -position: Vector2
    -velocity: Vector2
    -state: PlayerState
    +update(game: GameModel, deltaTime: double): void
    +move(deltaTime: double, held: Set<Direction>): void
    +setState(state: PlayerState): void
    +respawn(position: Vector2): void
    +canMove(): boolean
  }
  class Level {
    -safePath: List<Vector2>
    -pathHalfWidth: double
    -checkpoints: List<Vector2>
    -goal: Vector2
    +isSafe(position: Vector2): boolean
    +checkpointAt(position: Vector2): Optional<Vector2>
    +isGoal(position: Vector2): boolean
  }
  class Vector2 <<value>> {
    +x: double
    +y: double
  }
  class GameSnapshot <<immutable>> {
    +position: Vector2
    +velocity: Vector2
    +heldDirections: Set<Direction>
    +status: String
    +checkpoint: Vector2
    +level: Level
  }
  interface GameObserver {
    +onGameEvent(event: GameEvent): void
  }
  class GameEvent <<immutable>> {
    +type: GameEventType
    +snapshot: GameSnapshot
  }
  enum GameEventType {
    STATE_CHANGED
    FALL_DETECTED
    CHECKPOINT_ACTIVATED
    RESPAWNED
    GOAL_REACHED
  }
  enum Direction {
    UP
    DOWN
    LEFT
    RIGHT
  }
}

package "Player lifecycle (State)" {
  interface PlayerState {
    +update(player: Player, game: GameModel, deltaTime: double): void
    +allowsMovement(): boolean
  }
  class ActiveState {
    +update(player: Player, game: GameModel, deltaTime: double): void
    +allowsMovement(): boolean
  }
  class FallingState {
    +update(player: Player, game: GameModel, deltaTime: double): void
    +allowsMovement(): boolean
  }
  class RespawningState {
    +update(player: Player, game: GameModel, deltaTime: double): void
    +allowsMovement(): boolean
  }
  class FinishedState {
    +update(player: Player, game: GameModel, deltaTime: double): void
    +allowsMovement(): boolean
  }
}

package "Voice boundary (Adapter)" {
  class VoiceInputService {
    -epoch: long
    -utteranceId: long
    +start(epoch: long): void
    +acceptAudio(samples: float[]): void
    +onPartial(text: String): void
    +onEndpoint(): void
    +stop(): void
  }
  interface StreamingSpeechRecognizer {
    +start(onPartial: Consumer<String>, onEndpoint: Runnable, onError: Consumer<String>): void
    +acceptAudio(samples: float[]): void
    +stop(): void
  }
  class SherpaOnnxAdapter {
    +start(onPartial: Consumer<String>, onEndpoint: Runnable, onError: Consumer<String>): void
    +acceptAudio(samples: float[]): void
    +stop(): void
  }
  class TranscriptUpdate <<immutable>> {
    +text: String
    +utteranceId: long
    +version: long
    +epoch: long
  }
}

package "Agent interpretation (no game access)" {
  class VoiceCommandAgent {
    -utteranceBaseContext: ControlContext
    -currentUtteranceId: long
    -currentEpoch: long
    -inFlightCount: int
    -pendingUpdate: TranscriptUpdate
    -pendingContext: ControlContext
    +interpret(update: TranscriptUpdate, context: ControlContext): CompletionStage<ActionDecision>
    +reset(): void
  }
  interface DecisionModel {
    +decide(update: TranscriptUpdate, baseContext: ControlContext): CompletionStage<ActionDecision>
  }
  class OpenJevAdapter {
    +decide(update: TranscriptUpdate, baseContext: ControlContext): CompletionStage<ActionDecision>
  }
  class ControlContext <<immutable>> {
    +heldDirections: Set<Direction>
    +previousCommand: String
    +epoch: long
    +revision: long
    +latestVersion: long
    +movementAllowed: boolean
  }
  class ActionDecision <<immutable>> {
    +type: ActionType
    +directions: Set<Direction>
    +durationMs: int
    +transcriptVersion: long
    +utteranceId: long
    +epoch: long
    +contextRevision: long
    +sourceText: String
  }
  enum ActionType {
    PRESS
    RELEASE
    SWITCH
    TIMED_PRESS
    KEEP_CURRENT
    RELEASE_ALL
    NO_ACTION
  }
}

package "Deterministic control (Command)" {
  class ControlManager {
    -latestVersion: long
    -epoch: long
    -revision: long
    -previousCommand: String
    -lastAccepted: ActionDecision
    +beginInput(version: long): void
    +getContext(): ControlContext
    +accept(decision: ActionDecision): boolean
    +validate(decision: ActionDecision): boolean
    +plan(decision: ActionDecision): List<GameCommand>
    +advance(deltaTime: double): void
    +reset(): void
  }
  class ActionExecutor {
    -activeTimed: List<TimedPressCommand>
    +execute(commands: List<GameCommand>): void
    +cancelAll(): void
    +advance(deltaTime: double): boolean
  }
  interface GameCommand {
    +execute(game: GameModel): void
    +cancel(game: GameModel): void
  }
  class KeyDownCommand {
    -direction: Direction
    +execute(game: GameModel): void
    +cancel(game: GameModel): void
  }
  class KeyUpCommand {
    -direction: Direction
    +execute(game: GameModel): void
    +cancel(game: GameModel): void
  }
  class TimedPressCommand {
    -directions: Set<Direction>
    -remainingMs: double
    +execute(game: GameModel): void
    +cancel(game: GameModel): void
    +advance(deltaTime: double, game: GameModel): boolean
  }
  class ReleaseAllCommand {
    +execute(game: GameModel): void
    +cancel(game: GameModel): void
  }
}

package "External resources (conceptual boundaries)" {
  class MicrophoneDevice <<external>> {
    +open(): void
    +readSamples(): float[]
    +close(): void
  }
  class SherpaOnnxRuntime <<external>> {
    +openStream(): void
    +decode(samples: float[]): String
    +closeStream(): void
  }
  class OpenJevService <<external>> {
    +systemOne(state: String, choices: List<String>): String
  }
}

GameView <|.. JavaFxGameView
GameView <|.. CliView
GameObserver <|.. JavaFxGameView
GameObserver <|.. CliView
GameObserver <|.. ApplicationController
ApplicationController "1" --> "1" GameView : selected frontend
JavaFxGameView --> ApplicationController : session requests
ApplicationController "1" --> "1" GameModel
ApplicationController "1" --> "1" VoiceCommandAgent
ApplicationController "1" --> "1" ControlManager
ApplicationController "1" --> "0..1" VoiceInputService : GUI only
VoiceInputService --> ApplicationController : transcript/error callbacks
CliView ..> ApplicationController : typed input routed by start()
GameModel "1" *-- "1" Player
GameModel "1" *-- "1" Level
GameModel "1" o-- "1..*" GameObserver : registered observers
GameModel ..> GameSnapshot : publishes
GameModel ..> GameEvent : publishes
GameEvent --> GameEventType
GameEvent "1" --> "1" GameSnapshot
GameSnapshot --> Level : immutable geometry reference
Player --> Vector2
Level --> Vector2
GameModel --> Direction
Player "1" *-- "1" PlayerState : current state
PlayerState <|.. ActiveState
PlayerState <|.. FallingState
PlayerState <|.. RespawningState
PlayerState <|.. FinishedState
ActiveState ..> GameModel : evaluates path/checkpoint/goal
FallingState ..> GameModel : resets checkpoint
RespawningState ..> ActiveState : transitions to
GameModel ..> FallingState : on fall
GameModel ..> RespawningState : on reset
GameModel ..> FinishedState : on goal
VoiceInputService "1" --> "1" StreamingSpeechRecognizer
VoiceInputService "1" --> "1" MicrophoneDevice
StreamingSpeechRecognizer <|.. SherpaOnnxAdapter
SherpaOnnxAdapter --> SherpaOnnxRuntime : adapts
ApplicationController ..> TranscriptUpdate : assigns version
VoiceCommandAgent "1" --> "1" DecisionModel
DecisionModel <|.. OpenJevAdapter
OpenJevAdapter --> OpenJevService : adapts bounded choice API
VoiceCommandAgent ..> TranscriptUpdate
VoiceCommandAgent ..> ControlContext
VoiceCommandAgent ..> ActionDecision : stamps local request metadata
ActionDecision --> ActionType
ActionDecision --> Direction
ControlManager "1" --> "1" ActionExecutor
ControlManager --> GameModel : reads authoritative controls
ControlManager ..> ControlContext : snapshots
ControlManager ..> ActionDecision : validates
ControlManager ..> GameCommand : creates deterministic plan
ActionExecutor "1" o-- "0..*" GameCommand : pending or active
ActionExecutor "1" --> "1" GameModel : receiver
GameCommand <|.. KeyDownCommand
GameCommand <|.. KeyUpCommand
GameCommand <|.. TimedPressCommand
GameCommand <|.. ReleaseAllCommand
GameCommand ..> GameModel : execute/cancel receiver

note bottom of GameModel
  heldDirections is the only authoritative input set.
  GameSnapshot is read-only; Level geometry is immutable.
  All mutations run on one application loop.
end note
note bottom of VoiceCommandAgent
  Freeze interpretation context per (epoch, utteranceId).
  Stamp decisions with the CURRENT dispatch revision.
  At most two model calls and one latest pending input.
  Queued requests retain their submission context/deadline.
  No level, position, checkpoint, or goal is sent to AI.
end note
note bottom of SherpaOnnxRuntime
  External operations are conceptual contracts, not
  claims about vendor Java method names. See README 1.4.
end note
@enduml
